# Public URL this app is deployed at — used for absolute OG/social preview
# URLs. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=

# Supabase — create a project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk — create an app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk webhook — Dashboard > Webhooks > add endpoint pointing at
# /api/webhooks/clerk, subscribed to "user.deleted". Copy the signing
# secret it gives you here.
CLERK_WEBHOOK_SIGNING_SECRET=

# Postmark — https://postmarkapp.com. Server token works for both inbound
# (Phase 2, not yet built) and the outbound "broken link reported" email
# below. POSTMARK_FROM_EMAIL must be a verified sender/domain in Postmark.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# Your email — gates /admin/reports and receives a notification whenever
# someone reports a broken posting link.
ADMIN_EMAIL=

# Groq — open-weight model inference for email parsing, https://console.groq.com
GROQ_API_KEY=

# Secret for /api/sync-postings — any long random string. Set this in your
# Vercel project's env vars and Vercel Cron (see vercel.json) will
# automatically send it as `Authorization: Bearer <value>` on each run.
CRON_SECRET=

# Google Analytics 4 measurement ID (Admin > Data Streams in GA) — starts
# with "G-". Left unset in local/dev; only add this to Vercel's production
# env, since it's what turns tracking on.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Stripe CLI (local) or Dashboard webhook endpoint (production) signing secret
STRIPE_WEBHOOK_SIGNING_SECRET=
# Price IDs from the Stripe Dashboard's Product catalog
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

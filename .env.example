# Public URL this app is deployed at — used for absolute OG/social preview
# URLs. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=

# Supabase — create a project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk — create an app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk webhook — Dashboard > Webhooks > add endpoint pointing at
# /api/webhooks/clerk, subscribed to "user.deleted". Copy the signing
# secret it gives you here.
CLERK_WEBHOOK_SIGNING_SECRET=

# Postmark inbound email — https://postmarkapp.com
POSTMARK_SERVER_TOKEN=

# Groq — open-weight model inference for email parsing, https://console.groq.com
GROQ_API_KEY=

# Secret for /api/sync-postings — any long random string. Set this in your
# Vercel project's env vars and Vercel Cron (see vercel.json) will
# automatically send it as `Authorization: Bearer <value>` on each run.
CRON_SECRET=
